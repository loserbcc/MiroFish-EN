# LLM API Configuration (supports any LLM with OpenAI SDK format)
# Options: z.ai GLM, Google Gemini, DashScope Qwen, OpenAI, etc.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL_NAME=glm-4-plus

# ===== Zep Backend Configuration =====
# Backend choice: 'cloud' for Zep Cloud | 'graphiti' for local Neo4j
ZEP_BACKEND=graphiti

# Zep Cloud Configuration (required when ZEP_BACKEND=cloud)
# Free monthly quota sufficient for basic usage: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Graphiti / Neo4j Local Configuration (required when ZEP_BACKEND=graphiti) =====
# Start Neo4j: docker-compose -f docker-compose.local.yml up -d
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Graphiti requires an OpenAI-compatible LLM for entity extraction
# OPENAI_API_KEY/OPENAI_BASE_URL are automatically mapped from LLM_API_KEY/LLM_BASE_URL
# To configure a separate LLM for Graphiti, set explicitly:
# OPENAI_API_KEY=your_openai_key
# OPENAI_BASE_URL=https://api.openai.com/v1

# Graphiti default model (recommended to set explicitly to avoid incompatibility with OpenAI default model names)
# - z.ai chat: glm-4-plus
# - DashScope chat: qwen3-max
# - DashScope embedding: text-embedding-v4
GRAPHITI_LLM_MODEL=glm-4-plus
GRAPHITI_EMBEDDING_MODEL=text-embedding-v4

# Search reranking configuration (optional)
# Non-standard OpenAI APIs (e.g., DashScope) automatically fall back to RRF reranking
# If your API supports logprobs, you can force cross_encoder:
# GRAPHITI_FORCE_CROSS_ENCODER=true

# ===== Boost LLM Configuration (optional) =====
LLM_BOOST_API_KEY=your_boost_api_key_here
LLM_BOOST_BASE_URL=https://another-api-provider.com/v1
LLM_BOOST_MODEL_NAME=gpt-4o-mini
